[settings]
# Full list of parameters accepted in a parameter file.
# Values here override the command line. Do not quote values (except inside basis).

# functional: LDA | LSDA-CA | LSDA-PW | GGA-PBE
xc = GGA-PBE

# spin polarization: on (collinear) | off | nc (noncollinear)
pol = on

# output OpenMX file name
output = openmx_input_V2Se2O.dat

# output coordinates: F (fractional) | C (cartesian)
coord_system = F

# built-in basis size: Quick | Standard | Precise
basis_prec = Quick

# basis set / pseudopotential version (DFT_DATA19)
basis_ver = 19

# SCF k-grid: automatic n_i = ceil(kspacing / d_i), d_i = lattice-plane spacing in Ang
kspacing = 35
# or an explicit grid, overrides kspacing
#kgrid = 10 10 6

# band structure k-path (needs seekpath): on | off
band = off

# species order in the coordinates block (space separated)
element_order = V Se O

# custom basis per element (Python dict), overrides basis_prec
# (the values below are the Standard set)
#basis = {
#        'V':'V6.0-s3p2d1',
#        'Se':'Se7.0-s3p2d2',
#        'O':'O6.0-s2p2d1'
#        }

# initial moments: VASP MAGMOM string or a natoms-by-3 vector file (use only one)
# altermagnetic configuration: V1 down, V2 up
magmom = -1 1 3*0
#vector_file = vec_file
